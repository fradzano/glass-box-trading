{
  "name": "glass-box-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.9.0",
    "npm": "11.11.1"
  },
  "packageManager": "npm@11.11.1",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "architecture": "node tools/check-core-architecture.mjs --self-test",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "fixture": "npm run build && node dist/shell/render-fixture.js",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run architecture && npm run build && python tools/check_implementation_phases.py"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
