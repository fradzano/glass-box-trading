{
  "name": "glass-box-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.9.0",
    "npm": "11.11.1"
  },
  "packageManager": "npm@11.11.1",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "architecture": "node tools/check-core-architecture.mjs --self-test",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "fixture": "npm run build && node dist/shell/render-fixture.js",
    "dashboard": "node dist/shell/render-golden-dashboard.js",
    "sandbox": "node --experimental-vm-modules tools/run-core-sandboxed.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run architecture && npm run fixture && npm run dashboard && npm run sandbox && python tools/check_implementation_phases.py",
    "agent": "npm run build && node dist/shell/agent-cli.js",
    "certificate": "npm run build && node dist/shell/certificate-cli.js --owner-go",
    "deadline-reconciliation": "npm run build && node dist/shell/deadline-cli.js reconciliation",
    "deadline-terminal": "npm run build && node dist/shell/deadline-cli.js terminal"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.252",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  }
}
