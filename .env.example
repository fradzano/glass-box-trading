# Copy to .env and fill in. .env is gitignored — keys never enter the repo.

# --- Alpaca (paper only; this project never touches a live account) ---
# Dev account for exploration/testing. The competition account gets its own
# block on Aug 28 and is selected via ALPACA_PROFILE. Both order-capable origins
# are validated as the exact canonical paper API; redirects and live endpoints
# fail before broker access even if the account ID matches.
ALPACA_PROFILE=dev

ALPACA_DEV_KEY_ID=
ALPACA_DEV_SECRET_KEY=
ALPACA_DEV_BASE_URL=https://paper-api.alpaca.markets

ALPACA_COMP_KEY_ID=
ALPACA_COMP_SECRET_KEY=
ALPACA_COMP_BASE_URL=https://paper-api.alpaca.markets

# --- Analyst (Claude) ---
# The analyst child is spawned with a constructed environment. It uses DEV
# Alpaca credentials for data only; the versioned manifest generates
# ALPACA_TOOLSETS and must match the exact offered read-only MCP inventory.
ANALYST_ALPACA_PROFILE=dev
ANALYST_MCP_CAPABILITY_MANIFEST=config/analyst-mcp-readonly.json
ANALYST_MCP_RUNTIME_LOCK=config/analyst-runtime-lock.json
# The dedicated, pinned MCP environment (P7): <root>/src is the upstream clone
# at the locked commit, <root>/site the target-directory install of its frozen
# dependency lock; the runtime is the pinned CPython 3.14.1 python.exe whose
# digest the lock names, the launcher the install manager's shim it also names.
ANALYST_MCP_ENVIRONMENT_ROOT=
ANALYST_PYTHON_RUNTIME=
ANALYST_PYTHON_LAUNCHER=
# The analyst model (a breadth role; the gates decide, not the analyst).
ANALYST_MODEL=claude-sonnet-5

# --- Identity per role (S-J-06): the literal broker account number, never derived ---
ALPACA_DEV_ACCOUNT_ID=
ALPACA_COMP_ACCOUNT_ID=

# --- Deployment locations (S-CYC-11; host-local, outside the role-neutral policy digest) ---
# Absolute STATE_DIR per role: the competition journal must not inherit the dev journal.
STATE_DIR=
# The pre-armed diagnostic sink, a file outside STATE_DIR.
BOOTSTRAP_DIAGNOSTIC_SINK=
# The S-ARM-01 certificate path; required for competition arming, generated only by the dev live test.
PRE_ARM_CERTIFICATE=
# The dead-man check (S-G14-03): a healthchecks.io ping URL (a secret; redacted from the journal). Unset = local record only.
HEALTHCHECK_PING_URL=

# Preferred: Claude subscription auth via the Agent SDK (no key needed here).
# Fallback for unattended runs if plan-auth refresh proves brittle:
ANTHROPIC_API_KEY=
