# Copy to .env and fill in. .env is gitignored — keys never enter the repo.

# --- Alpaca (paper only; this project never touches a live account) ---
# Dev account for exploration/testing. The competition account gets its own
# block on Aug 28 and is selected via ALPACA_PROFILE. The sole order-capable
# origin lives in config/policy.json and is validated as the exact canonical
# paper API; redirects and live endpoints fail before broker access.
ALPACA_PROFILE=dev

ALPACA_DEV_KEY_ID=
ALPACA_DEV_SECRET_KEY=

ALPACA_COMP_KEY_ID=
ALPACA_COMP_SECRET_KEY=

# --- Analyst (Claude) ---
# The analyst child is spawned with a constructed environment. It uses DEV
# Alpaca credentials for data only; the versioned manifest generates
# ALPACA_TOOLSETS and must match the exact offered read-only MCP inventory.
ANALYST_ALPACA_PROFILE=dev
ANALYST_MCP_CAPABILITY_MANIFEST=config/analyst-mcp-readonly.json
ANALYST_MCP_RUNTIME_LOCK=config/analyst-runtime-lock.json
# The dedicated, pinned MCP environment (P7): <root>/src is the upstream clone
# at the locked commit, <root>/site the target-directory install of its frozen
# dependency lock; the runtime is the pinned CPython 3.14.1 python.exe whose
# digest the lock names, the launcher the install manager's shim it also names.
ANALYST_MCP_ENVIRONMENT_ROOT=
ANALYST_PYTHON_RUNTIME=
ANALYST_PYTHON_LAUNCHER=
# The analyst model (a breadth role; the gates decide, not the analyst).
# Classified "policy" (src/core/certificate.ts) despite living in the
# environment: it enters the S-ARM-01 policyDigest. It must be byte-identical
# between the host that ran the certificate and the host that operates the
# competition account, or arming refuses on a policy-digest mismatch.
ANALYST_MODEL=claude-sonnet-5

# --- Identity per role (S-J-06): the literal broker account number, never derived ---
ALPACA_DEV_ACCOUNT_ID=
ALPACA_COMP_ACCOUNT_ID=

# --- Deployment locations (S-CYC-11; host-local, outside the role-neutral policy digest) ---
# Absolute STATE_DIR per role: the competition journal must not inherit the dev journal.
STATE_DIR=
# The pre-armed diagnostic sink, a file outside STATE_DIR.
BOOTSTRAP_DIAGNOSTIC_SINK=
# The S-ARM-01 certificate path; required for competition arming, generated only by the dev live test.
PRE_ARM_CERTIFICATE=
# --- Alerting: two signals, two endpoints (S-G14-05, A31) ---
# READINESS (S-G14-03 dead-man + every impediment): the runtime pings this on
# success and POSTs <url>/fail with the conditions otherwise. A standing halt or
# an unreleased credential fence keeps it failing until a human clears it.
# A secret; redacted from the journal. Unset = local record only, which is what
# the whole competition ran on: seventy pings into a file on the machine most
# likely to have died. An unattended run may not start on that.
HEALTHCHECK_PING_URL=
# LIVENESS: tools\cycle-run.ps1 pings this on EVERY scheduled firing, including
# the ones it skips outside the session, and POSTs <url>/fail when the agent
# exits non-zero. It claims only that the scheduler fired and the wrapper ran —
# never that the deployment can trade. Its absence is what tells you the machine,
# the scheduler or the process is gone.
# Exercise both with tools\check-alert-path.ps1 before an unattended run.
HEALTHCHECK_LIVENESS_URL=

# Claude subscription auth via the Agent SDK. P7 requires the setup-token OAuth
# value below; the earlier API-key fallback design was not implemented.
CLAUDE_CODE_OAUTH_TOKEN=

# Do NOT set ANTHROPIC_API_KEY. CONCEPT.md is explicit that it must not be
# present in this process's environment (its name fragment "ANTHROPIC" is one
# of the forbidden analyst-child leak patterns, src/core/startup.ts
# forbiddenEnvFragments). runtime-config.ts still reads it — only to add it to
# the journal-redaction secret list if it is ever present — but nothing in
# this codebase consumes it for authentication; leave it unset.
